{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Preview Worker for V2. Not connected to the live GitHub Pages site or any domain.
  "name": "coffeella-v2-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "coffeella-v2-preview"
    }
  ],
  // Create with: npx wrangler kv namespace create NEXT_INC_CACHE_KV (and NEXT_TAG_CACHE_KV),
  // then replace the placeholder ids. Local "wrangler dev" simulates KV without an account.
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "REPLACE_WITH_INC_CACHE_KV_ID" },
    { "binding": "NEXT_TAG_CACHE_KV", "id": "REPLACE_WITH_TAG_CACHE_KV_ID" }
  ],
  "observability": { "enabled": true }
}
