{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run supabase/tests",
    "data:export": "node scripts/export-v1-menu.mjs",
    "data:seed": "node scripts/generate-seed.mjs",
    "data:check": "node scripts/export-v1-menu.mjs --check && node scripts/generate-seed.mjs --check",
    "check": "npm run data:check && npm run typecheck && npm run lint && npm run test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@puckeditor/core": "^0.23.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
