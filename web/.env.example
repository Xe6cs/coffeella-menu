# Copy to .env.local (local development) and fill in real values there.
# .env.local is ignored by Git. NEVER commit real keys.

# --- Public values (safe in the browser) -------------------------------------
# Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase dashboard → Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public URL of the deployed site (used for social previews and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) --------------------
# Supabase dashboard → Project Settings → API Keys → Secret key (sb_secret_...)
# Needed later for admin actions that must also update Supabase Auth (e.g. banning sign-in).
SUPABASE_SECRET_KEY=

# Shared secret for POST /api/internal/revalidate (Supabase Database Webhooks
# and the admin panel use it to refresh the public menu after a change).
# At least 32 random characters; generate e.g. with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty to disable the endpoint.
REVALIDATE_SECRET=

# --- Analytics (later phase) ---------------------------------------------------
# PostHog → Project settings → Project API key / host
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
